model Deal {
  id                              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                  String            @map("organization_id") @db.Uuid
  eventId                         String            @map("event_id") @db.Uuid
  businessPartnerId               String            @map("business_partner_id") @db.Uuid
  contactId                       String?           @map("contact_id") @db.Uuid
  sourceTemplateId                String?           @map("source_template_id") @db.Uuid
  sourceTemplateVersion           Int?              @map("source_template_version")
  sourceTemplateNameSnapshot      String?           @map("source_template_name_snapshot") @db.VarChar(200)
  customerNameSnapshot            String            @map("customer_name_snapshot") @db.VarChar(200)
  contactNameSnapshot             String?           @map("contact_name_snapshot") @db.VarChar(200)
  status                          DealStatus        @default(ENTWURF)
  totalDiscountType               DealDiscountType? @map("total_discount_type")
  totalDiscountFixedMinor         BigInt?           @map("total_discount_fixed_minor")
  totalDiscountPercentageBasisPoints Int?           @map("total_discount_percentage_basis_points")
  currency                        String            @default("EUR") @db.Char(3)
  version                         Int               @default(1)
  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @updatedAt @map("updated_at")
  organization                    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event                           Event             @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  businessPartner                 BusinessPartner   @relation(fields: [businessPartnerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contact                         Contact?          @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceTemplate                  DealTemplate?     @relation(fields: [sourceTemplateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  components                      DealComponent[]
  servicePositions                DealServicePosition[]
  statusHistory                   DealStatusHistory[]

  @@unique([id, organizationId])
  @@index([organizationId, eventId, status, createdAt])
  @@index([organizationId, businessPartnerId])
  @@index([organizationId, contactId])
  @@index([organizationId, sourceTemplateId])
  @@map("deal")
}

