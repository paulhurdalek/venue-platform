{
  "name": "@venue/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm prisma:generate && vitest run",
    "test:db": "pnpm prisma:generate && vitest run src/database.connection.integration.spec.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:status": "prisma migrate status --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.21.0",
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
