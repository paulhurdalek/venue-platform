{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_get_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Report application and database health",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Venue Platform API",
    "description": "Technical Phase 0 API foundation",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ServiceHealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ServicesHealthDto": {
        "type": "object",
        "properties": {
          "application": {
            "$ref": "#/components/schemas/ServiceHealthDto"
          },
          "database": {
            "$ref": "#/components/schemas/ServiceHealthDto"
          }
        },
        "required": [
          "application",
          "database"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "services": {
            "$ref": "#/components/schemas/ServicesHealthDto"
          }
        },
        "required": [
          "status",
          "timestamp",
          "services"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Request validation failed"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string",
            "example": "01HZX3Q4Y7R4Y6RDXP7T6W4KM2"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "timestamp"
        ]
      }
    }
  }
}
