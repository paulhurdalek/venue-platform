{
  "name": "@venue/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src --exclude src/**/*.integration.spec.ts",
    "test:integration": "vitest run src/health/health.integration.spec.ts integration/phase-1.integration.spec.ts integration/phase-3.integration.spec.ts integration/phase-4.integration.spec.ts integration/phase-5.integration.spec.ts integration/phase-6.integration.spec.ts integration/phase-7.integration.spec.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.25",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "11.4.6",
    "@venue/configuration": "workspace:*",
    "@venue/database": "workspace:*",
    "@venue/shared": "workspace:*",
    "better-auth": "1.6.25",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.1.0",
    "helmet": "8.3.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.29",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
